author = Andrzej Cichocki
author_email = 3613868+combatopera@users.noreply.github.com
buildbot enabled = true
github account = combatopera
name = Leytonium
pydoc_enabled = false
pypi account = combatopera
pyversions += 3
requires +=
    aridity>=62
    autopep8>=1.5.4
    awscli>=1.19.53
    docutils>=0.15.2
    importlib-metadata>=2.1.1
    lagoon>=35
    PyGObject>=3.42.2
    pytz>=2020.4
    pyven>=90
    PyYAML>=5.2
    setuptools>=44.1.1
    termcolor>=1.1.0
    Unidecode>=1.3.2
resource types += bash
tagline = Tools for developing git-managed software
upstream devel packages += libgirepository1.0-dev
years += 2020
